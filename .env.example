# Deployment identity. Allowed: local, test, staging, production.
APP_ENV=local

# Public values are embedded in the browser bundle. Never place secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PHOTOBOOTH_ENABLED=false
NEXT_PUBLIC_REALTIME_ENABLED=false

# Required in staging and production. Generate a unique value with at least
# 32 characters and store the real value in the deployment secret manager.
GUEST_TOKEN_SIGNING_SECRET=

# Local PostgreSQL and Redis services from compose.yaml.
DATABASE_URL=postgresql://wedding_quest:wedding_quest_local@localhost:55432/wedding_quest
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://localhost:56379
QUEUE_PREFIX=wedding-quest-local

# Optional local S3-compatible endpoint. Production uses separate R2 credentials.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=wedding-quest-local
OBJECT_STORAGE_ACCESS_KEY_ID=wedding_quest_local
OBJECT_STORAGE_SECRET_ACCESS_KEY=wedding_quest_local_secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
